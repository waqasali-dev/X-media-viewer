# Server Port (Render assigns PORT automatically in production)
PORT=4000

# Optional: Supply sessions directly via environment variable on Render
# X_COOKIES_JSON=[{"label":"burner-1","auth_token":"...","ct0":"..."}]

# Optional: Single account fallback credentials
# X_AUTH_TOKEN=
# X_CT0=

# Optional: Scraper mode ("auto", "graphql", "playwright")
X_SCRAPER_MODE=auto
